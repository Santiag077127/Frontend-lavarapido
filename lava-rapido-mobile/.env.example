# En desarrollo con un celular Android, usa http://IP_WIFI_DEL_PC:8081.
# En el emulador Android, usa http://10.0.2.2:8081.
# En producción, usa el origen HTTPS público del backend.
# No agregues /api ni credenciales: esta variable es visible en el bundle móvil.
EXPO_PUBLIC_API_URL=https://api.example.invalid
