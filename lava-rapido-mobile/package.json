{
  "name": "lava-rapido-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "build": "expo export --platform android",
    "generate:leaflet": "node scripts/generateLeafletResources.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/services/*.test.ts",
    "test:ui": "jest --config jest.config.js --runInBand",
    "test:ui:coverage": "jest --config jest.config.js --runInBand --coverage",
    "test:ui:coverage:vehicles": "jest --config jest.config.js --runInBand --coverage --testTimeout=15000 --coverageDirectory=coverage/vehicles --collectCoverageFrom=src/services/vehicleService.ts --collectCoverageFrom=src/features/vehicles/**/*.ts --collectCoverageFrom=src/features/vehicles/**/*.tsx --runTestsByPath src/features/vehicles/screens/AddVehicleScreen.test.tsx src/features/vehicles/screens/MyVehiclesScreen.test.tsx src/features/vehicles/services/vehicleService.test.tsx src/features/vehicles/services/sharedVehicleService.test.tsx src/features/reservations/screens/ReservationScreen.test.tsx"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "axios": "^1.16.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "i18next": "^23.11.0",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-i18next": "^14.1.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "~19.3.0",
    "expo-modules-core": "~58.0.26",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
